<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AlessandroGozzi.AppAAC.MobileGUI.ViewModels"
             xmlns:models="clr-namespace:AlessandroGozzi.AppAAC.Domain.Models;assembly=AlessandroGozzi.AppAAC.Domain"
             x:Class="AlessandroGozzi.AppAAC.MobileGUI.HomePage"
             x:DataType="vm:HomeViewModel"
             x:Name="RootPage"
             Title="Seleziona Routine"
             BackgroundColor="#F0F4F8">

    <Grid RowDefinitions="*, Auto">

        <!-- 1. Griglia Routine AAC -->
        <CollectionView Grid.Row="0"
                        ItemsSource="{Binding Routines}"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedRoutine, Mode=TwoWay}"
                        Margin="16">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical"
                                 Span="2"
                                 HorizontalItemSpacing="14"
                                 VerticalItemSpacing="14" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Routine">
                    <Border x:Name="RoutineCard"
                            StrokeShape="RoundRectangle 22"
                            Stroke="#E2E8F0"
                            StrokeThickness="2"
                            BackgroundColor="#FFFFFF"
                            Padding="14"
                            HeightRequest="190">

                        <!-- Ombreggiatura morbida -->
                        <Border.Shadow>
                            <Shadow Brush="#150284C7"
                                    Offset="0,4"
                                    Radius="10"
                                    Opacity="0.4" />
                        </Border.Shadow>

                        <!-- Feedback visivo morbido: selezione azzurra coordinata MioEco -->
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup Name="CommonStates">
                                <VisualState Name="Normal" />
                                <VisualState Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Property="Stroke" Value="#0284C7" />
                                        <Setter Property="StrokeThickness" Value="3" />
                                        <Setter Property="BackgroundColor" Value="#E0F2FE" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <VerticalStackLayout Spacing="10"
                                             HorizontalOptions="Center"
                                             VerticalOptions="Center">

                            <!-- Pittogramma della Routine -->
                            <Image Source="{Binding ImageUrl}"
                                   WidthRequest="95"
                                   HeightRequest="95"
                                   Aspect="AspectFit"
                                   HorizontalOptions="Center" />

                            <!-- Nome Routine ad alto contrasto -->
                            <Label Text="{Binding Name}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#0F2A4A"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="2" />

                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <Label Text="Nessuna routine trovata nel database."
                       FontSize="16"
                       TextColor="#64748B"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </CollectionView.EmptyView>
        </CollectionView>

        <!-- Indicatore di caricamento -->
        <ActivityIndicator Grid.Row="0"
                           IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           Color="#0284C7"
                           WidthRequest="48"
                           HeightRequest="48"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />

        <!-- 2. Barra inferiore coordinata in azzurro MioEco -->
        <Border Grid.Row="1"
                BackgroundColor="#FFFFFF"
                StrokeShape="RoundRectangle 24,24,0,0"
                Padding="16,14,16,18"
                Stroke="#E2E8F0">
            <Border.Shadow>
                <Shadow Brush="#10000000"
                        Offset="0,-4"
                        Radius="12"
                        Opacity="0.5" />
            </Border.Shadow>

            <Button Text="Seleziona Routine"
                    Command="{Binding LoadRoutineActionsCommand}"
                    BackgroundColor="#0284C7"
                    TextColor="#FFFFFF"
                    FontSize="18"
                    FontAttributes="Bold"
                    CornerRadius="16"
                    HeightRequest="56" />
        </Border>

    </Grid>
</ContentPage>