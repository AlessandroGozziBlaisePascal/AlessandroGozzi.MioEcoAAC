<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AlessandroGozzi.AppAAC.MobileGUI.IntroPage"
             BackgroundColor="#F8FAFC"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False">

    <Grid>
        <!-- Contenitore animato -->
        <VerticalStackLayout x:Name="LogoContainer"
                             Spacing="28"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             Opacity="0"
                             Scale="0.8">

            <!-- Card contenitore: grandezza invariata (270x270), padding ridotto per espandere il logo -->
            <Border Stroke="#E2E8F0"
                    StrokeThickness="1"
                    Background="#FFFFFF"
                    Padding="6"
                    HorizontalOptions="Center"
                    WidthRequest="270"
                    HeightRequest="270">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="36" />
                </Border.StrokeShape>

                <Border.Shadow>
                    <Shadow Brush="#15000000"
                            Offset="0,6"
                            Radius="16"
                            Opacity="0.8" />
                </Border.Shadow>

                <!-- Immagine ingrandita al massimo all'interno del riquadro -->
                <Image Source="logoapp.png"
                       Aspect="AspectFit"
                       WidthRequest="240"
                       HeightRequest="240"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>

            <!-- Nome dell'applicazione: ingrandito a 60 -->
            <Label Text="MioEco"
                   FontFamily="cursive"
                   FontSize="60"
                   FontAttributes="Bold"
                   CharacterSpacing="2"
                   TextColor="#0F2A4A"
                   HorizontalTextAlignment="Center">
                <Label.Shadow>
                    <Shadow Brush="#300F2A4A"
                            Offset="2,4"
                            Radius="8"
                            Opacity="0.4" />
                </Label.Shadow>
            </Label>

        </VerticalStackLayout>
    </Grid>

</ContentPage>