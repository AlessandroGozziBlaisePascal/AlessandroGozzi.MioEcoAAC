<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AlessandroGozzi.AppAAC.MobileGUI.IntroPage"
             BackgroundColor="#F8FAFC"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False">

    <Grid>
        <!-- Stelline ed Effetti Luminosi a Sinistra -->
        <Label x:Name="StarLeft1" Text="✨" FontSize="36" TextColor="#F59E0B"
               HorizontalOptions="Start" VerticalOptions="Start" Margin="35, 140, 0, 0"
               Opacity="0" Scale="0.5" />
        <Label x:Name="StarLeft2" Text="⭐" FontSize="26" TextColor="#FBBF24"
               HorizontalOptions="Start" VerticalOptions="Center" Margin="25, 0, 0, 40"
               Opacity="0" Scale="0.5" />
        <Label x:Name="StarLeft3" Text="✨" FontSize="32" TextColor="#F59E0B"
               HorizontalOptions="Start" VerticalOptions="End" Margin="45, 0, 0, 160"
               Opacity="0" Scale="0.5" />

        <!-- Stelline ed Effetti Luminosi a Destra -->
        <Label x:Name="StarRight1" Text="⭐" FontSize="28" TextColor="#FBBF24"
               HorizontalOptions="End" VerticalOptions="Start" Margin="0, 160, 40, 0"
               Opacity="0" Scale="0.5" />
        <Label x:Name="StarRight2" Text="✨" FontSize="38" TextColor="#F59E0B"
               HorizontalOptions="End" VerticalOptions="Center" Margin="0, 40, 25, 0"
               Opacity="0" Scale="0.5" />
        <Label x:Name="StarRight3" Text="⭐" FontSize="24" TextColor="#FBBF24"
               HorizontalOptions="End" VerticalOptions="End" Margin="0, 0, 50, 140"
               Opacity="0" Scale="0.5" />

        <!-- Contenitore centrale (Logo + Titolo) -->
        <VerticalStackLayout x:Name="LogoContainer"
                             Spacing="28"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             Opacity="0"
                             Scale="0.8">

            <!-- Card contenitore -->
            <Border Stroke="#E2E8F0"
                    StrokeThickness="1"
                    Background="#FFFFFF"
                    Padding="6"
                    HorizontalOptions="Center"
                    WidthRequest="270"
                    HeightRequest="270">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="36" />
                </Border.StrokeShape>

                <Border.Shadow>
                    <Shadow Brush="#15000000"
                            Offset="0,6"
                            Radius="16"
                            Opacity="0.8" />
                </Border.Shadow>

                <Image Source="logoapp.png"
                       Aspect="AspectFit"
                       WidthRequest="240"
                       HeightRequest="240"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>

            <!-- Nome applicazione -->
            <Label Text="MioEco"
                   FontFamily="cursive"
                   FontSize="60"
                   FontAttributes="Bold"
                   CharacterSpacing="2"
                   TextColor="#0F2A4A"
                   HorizontalTextAlignment="Center">
                <Label.Shadow>
                    <Shadow Brush="#300F2A4A"
                            Offset="2,4"
                            Radius="8"
                            Opacity="0.4" />
                </Label.Shadow>
            </Label>

        </VerticalStackLayout>
    </Grid>

</ContentPage>