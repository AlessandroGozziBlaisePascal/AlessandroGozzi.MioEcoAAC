<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:AlessandroGozzi.AppAAC.Domain.Models;assembly=AlessandroGozzi.AppAAC.Domain"
             xmlns:viewmodels="clr-namespace:AlessandroGozzi.AppAAC.MobileGUI.ViewModels"
             x:Class="AlessandroGozzi.AppAAC.MobileGUI.Pages.ActivityPage"
             x:DataType="viewmodels:ActivityViewModel"
             BackgroundColor="#F0F4F8"
             Shell.BackButtonBehavior="{BackButtonBehavior IsVisible=False}">

    <!-- Barra superiore personalizzata coordinata -->
    <Shell.TitleView>
        <Grid ColumnDefinitions="Auto, *" VerticalOptions="Center" ColumnSpacing="12">
            <ImageButton Grid.Column="0"
                         Command="{Binding TornaIndietroCommand}"
                         BackgroundColor="Transparent"
                         HeightRequest="40"
                         WidthRequest="40"
                         Padding="6"
                         Aspect="AspectFit">
                <ImageButton.Source>
                    <FontImageSource Glyph="&#x2190;"
                                     FontFamily="OpenSansSemibold"
                                     Color="#0F2A4A"
                                     Size="26" />
                </ImageButton.Source>
            </ImageButton>

            <Label Grid.Column="1"
                   Text="{Binding RoutineTitle}"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="#0F2A4A"
                   VerticalTextAlignment="Center" />
        </Grid>
    </Shell.TitleView>

    <!-- Griglia principale con area scroll e barra inferiore fissa -->
    <Grid RowDefinitions="*, Auto">

        <!-- Selezione Attività -->
        <CollectionView Grid.Row="0"
                        ItemsSource="{Binding Activities}"
                        SelectedItem="{Binding SelectedActivity, Mode=TwoWay}"
                        SelectionMode="Single"
                        Margin="16">

            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical"
                                 Span="2"
                                 HorizontalItemSpacing="14"
                                 VerticalItemSpacing="14" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Activity">
                    <Border x:Name="ActivityCard"
                            StrokeShape="RoundRectangle 22"
                            Stroke="#E2E8F0"
                            StrokeThickness="2"
                            BackgroundColor="#FFFFFF"
                            Padding="14"
                            HeightRequest="190">

                        <Border.Shadow>
                            <Shadow Brush="#150284C7"
                                    Offset="0,4"
                                    Radius="10"
                                    Opacity="0.4" />
                        </Border.Shadow>

                        <!-- Feedback visivo allineato allo stile MioEco -->
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup Name="CommonStates">
                                <VisualState Name="Normal" />
                                <VisualState Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Property="Stroke" Value="#0284C7" />
                                        <Setter Property="StrokeThickness" Value="3" />
                                        <Setter Property="BackgroundColor" Value="#E0F2FE" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <VerticalStackLayout Spacing="10"
                                             HorizontalOptions="Center"
                                             VerticalOptions="Center">
                            <Image Source="{Binding ImageUrl}"
                                   WidthRequest="95"
                                   HeightRequest="95"
                                   Aspect="AspectFit"
                                   HorizontalOptions="Center" />

                            <Label Text="{Binding Name}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#0F2A4A"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="2" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Barra fissa inferiore con il pulsante Seleziona Attività -->
        <Border Grid.Row="1"
                BackgroundColor="#FFFFFF"
                StrokeShape="RoundRectangle 24,24,0,0"
                Padding="16,14,16,18"
                Stroke="#E2E8F0">
            <Border.Shadow>
                <Shadow Brush="#10000000"
                        Offset="0,-4"
                        Radius="12"
                        Opacity="0.5" />
            </Border.Shadow>

            <Button Text="Seleziona Attività"
                    Command="{Binding ConfermaAttivitaCommand}"
                    BackgroundColor="#0284C7"
                    TextColor="#FFFFFF"
                    FontSize="18"
                    FontAttributes="Bold"
                    CornerRadius="16"
                    HeightRequest="56" />
        </Border>

    </Grid>
</ContentPage>