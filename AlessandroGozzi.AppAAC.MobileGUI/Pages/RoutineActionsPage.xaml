<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:AlessandroGozzi.AppAAC.MobileGUI.ViewModels"
             x:Class="AlessandroGozzi.AppAAC.MobileGUI.Pages.RoutineActionsPage"
             x:DataType="viewmodels:ActionsViewModel"
             x:Name="ThisActionsPage"
             Shell.BackButtonBehavior="{BackButtonBehavior IsVisible=False}"
             BackgroundColor="#F0F4F8">

    <!-- Barra superiore coordinata con freccia indietro, titolo e tasto Modifica -->
    <Shell.TitleView>
        <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center" Margin="0,0,16,0" ColumnSpacing="12">
            <!-- Freccia Torna Indietro -->
            <ImageButton Grid.Column="0"
                         Command="{Binding TornaIndietroCommand}"
                         BackgroundColor="Transparent"
                         HeightRequest="40"
                         WidthRequest="40"
                         Padding="6"
                         Aspect="AspectFit">
                <ImageButton.Source>
                    <FontImageSource Glyph="&#x2190;"
                                     FontFamily="OpenSansSemibold"
                                     Color="#0F2A4A"
                                     Size="26" />
                </ImageButton.Source>
            </ImageButton>

            <!-- Titolo Attività / Azioni -->
            <Label Grid.Column="1"
                   Text="{Binding ActivityTitle, FallbackValue='Azioni da fare'}"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="#0F2A4A"
                   LineBreakMode="TailTruncation"
                   VerticalTextAlignment="Center" />

            <!-- Tasto Toggle Modifica (Pillola rettangolare smussata) -->
            <Border Grid.Column="2"
                    StrokeThickness="1.5"
                    StrokeShape="RoundRectangle 10"
                    Padding="16,8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Stroke" Value="#0284C7" />
                        <Setter Property="BackgroundColor" Value="#FFFFFF" />
                        <Style.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsEditMode}" Value="True">
                                <Setter Property="Stroke" Value="#16A34A" />
                                <Setter Property="BackgroundColor" Value="#F0FDF4" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleEditModeCommand}" />
                </Border.GestureRecognizers>

                <Label Text="{Binding EditButtonText}"
                       FontSize="14"
                       FontAttributes="Bold"
                       VerticalTextAlignment="Center">
                    <Label.Style>
                        <Style TargetType="Label">
                            <Setter Property="TextColor" Value="#0284C7" />
                            <Style.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsEditMode}" Value="True">
                                    <Setter Property="TextColor" Value="#16A34A" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Label.Style>
                </Label>
            </Border>
        </Grid>
    </Shell.TitleView>

    <Grid RowDefinitions="*, Auto">

        <!-- 1. AREA CONTENUTO SCORREVOLE -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="14" Margin="16">

                <!-- Griglia Azioni -->
                <CollectionView ItemsSource="{Binding ActionItems}"
                                SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical"
                                         Span="2"
                                         HorizontalItemSpacing="14"
                                         VerticalItemSpacing="14" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:ActionStepItem">
                            <Grid HeightRequest="190">

                                <!-- CARD AZIONE NORMALE -->
                                <Border StrokeThickness="2"
                                        StrokeShape="RoundRectangle 22"
                                        Padding="14">

                                    <Border.Shadow>
                                        <Shadow Brush="#150284C7"
                                                Offset="0,4"
                                                Radius="10"
                                                Opacity="0.4" />
                                    </Border.Shadow>

                                    <!-- Stile dinamico: Normale / Selezionata / Edit / Completata -->
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <!-- Stato base: bloccato o inattivo -->
                                            <Setter Property="Stroke" Value="#E2E8F0" />
                                            <Setter Property="BackgroundColor" Value="#FFFFFF" />
                                            <Setter Property="Opacity" Value="0.5" />

                                            <Style.Triggers>
                                                <!-- Azione sbloccata / attiva in modalità normale -->
                                                <DataTrigger TargetType="Border" Binding="{Binding IsUnlocked}" Value="True">
                                                    <Setter Property="Stroke" Value="#E2E8F0" />
                                                    <Setter Property="BackgroundColor" Value="#FFFFFF" />
                                                    <Setter Property="Opacity" Value="1.0" />
                                                </DataTrigger>

                                                <!-- Azione completata -->
                                                <DataTrigger TargetType="Border" Binding="{Binding IsCompleted}" Value="True">
                                                    <Setter Property="Stroke" Value="#16A34A" />
                                                    <Setter Property="BackgroundColor" Value="#F0FDF4" />
                                                    <Setter Property="Opacity" Value="0.95" />
                                                </DataTrigger>

                                                <!-- In modalità modifica, se selezionata: ROSSO -->
                                                <MultiTrigger TargetType="Border">
                                                    <MultiTrigger.Conditions>
                                                        <BindingCondition Binding="{Binding IsSelected}" Value="True" />
                                                        <BindingCondition Binding="{Binding Source={x:Reference ThisActionsPage}, Path=BindingContext.IsEditMode}" Value="True" />
                                                    </MultiTrigger.Conditions>
                                                    <Setter Property="Stroke" Value="#EF4444" />
                                                    <Setter Property="StrokeThickness" Value="3" />
                                                    <Setter Property="BackgroundColor" Value="#FEE2E2" />
                                                    <Setter Property="Opacity" Value="1.0" />
                                                </MultiTrigger>

                                                <!-- Nasconde se è la card '+' -->
                                                <DataTrigger TargetType="Border" Binding="{Binding IsAddButton}" Value="True">
                                                    <Setter Property="IsVisible" Value="False" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={x:Reference ThisActionsPage}, Path=BindingContext.AzioneToccataCommand}"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>

                                    <VerticalStackLayout Spacing="10"
                                                         HorizontalOptions="Center"
                                                         VerticalOptions="Center">

                                        <Grid HorizontalOptions="Center">
                                            <Image Source="{Binding Action.ImageUrl}"
                                                   WidthRequest="95"
                                                   HeightRequest="95"
                                                   Aspect="AspectFit" />

                                            <!-- Badge spunta verde se completato -->
                                            <Border BackgroundColor="#16A34A"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 14"
                                                    WidthRequest="28"
                                                    HeightRequest="28"
                                                    HorizontalOptions="End"
                                                    VerticalOptions="Start"
                                                    Margin="0,-4,-4,0"
                                                    IsVisible="{Binding IsCompleted}">
                                                <Label Text="✓"
                                                       TextColor="White"
                                                       FontSize="16"
                                                       FontAttributes="Bold"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center" />
                                            </Border>
                                        </Grid>

                                        <Label Text="{Binding Action.Name}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="#0F2A4A"
                                               HorizontalTextAlignment="Center"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="2" />
                                    </VerticalStackLayout>
                                </Border>

                                <!-- CARD TRATTEGGIATA CON '+' (Visibile solo in Edit Mode) -->
                                <Border Stroke="#0284C7"
                                        StrokeThickness="2"
                                        StrokeDashArray="4,2"
                                        StrokeShape="RoundRectangle 22"
                                        BackgroundColor="#F0F9FF"
                                        Padding="14"
                                        IsVisible="False">

                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsAddButton}" Value="True">
                                            <Setter Property="IsVisible" Value="True" />
                                        </DataTrigger>
                                    </Border.Triggers>

                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={x:Reference ThisActionsPage}, Path=BindingContext.AggiungiAzioneCommand}" />
                                    </Border.GestureRecognizers>

                                    <VerticalStackLayout Spacing="10"
                                                         HorizontalOptions="Center"
                                                         VerticalOptions="Center">
                                        <Label Text="+"
                                               FontSize="48"
                                               FontAttributes="Bold"
                                               TextColor="#0284C7"
                                               HorizontalOptions="Center" />

                                        <Label Text="Aggiungi azione"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="#0284C7"
                                               HorizontalTextAlignment="Center"
                                               HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </Border>

                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.EmptyView>
                        <Label Text="Nessuna azione presente per questa attività."
                               FontSize="16"
                               TextColor="#64748B"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Margin="0,40,0,0" />
                    </CollectionView.EmptyView>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Indicatore di caricamento -->
        <ActivityIndicator Grid.Row="0"
                           IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           Color="#0284C7"
                           WidthRequest="48"
                           HeightRequest="48"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />

        <!-- 2. BARRA INFERIORE DI ELIMINAZIONE (Attiva solo in Edit Mode) -->
        <Border Grid.Row="1"
                BackgroundColor="#FFFFFF"
                StrokeShape="RoundRectangle 24,24,0,0"
                Padding="16,14,16,18"
                Stroke="#E2E8F0"
                IsVisible="{Binding IsEditMode}">
            <Border.Shadow>
                <Shadow Brush="#10000000"
                        Offset="0,-4"
                        Radius="12"
                        Opacity="0.5" />
            </Border.Shadow>

            <Button Text="Elimina Azione"
                    Command="{Binding EliminaAzioneCommand}"
                    CommandParameter="{Binding SelectedActionItem}"
                    BackgroundColor="#EF4444"
                    TextColor="#FFFFFF"
                    FontSize="18"
                    FontAttributes="Bold"
                    CornerRadius="16"
                    HeightRequest="56" />
        </Border>

        <!-- 3. OVERLAY MODALE A SCHERMO INTERO (Per l'esecuzione dell'azione) -->
        <Grid Grid.RowSpan="2"
              BackgroundColor="#CC0F2A4A"
              IsVisible="{Binding IsModalOpen}"
              Padding="20"
              RowDefinitions="*, Auto">

            <!-- Card centrale ingrandita -->
            <Border Grid.Row="0"
                    Stroke="#38BDF8"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 28"
                    BackgroundColor="#FFFFFF"
                    Padding="24"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    MaximumWidthRequest="380">

                <Border.Shadow>
                    <Shadow Brush="#30000000"
                            Offset="0,8"
                            Radius="24"
                            Opacity="0.8" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="20" HorizontalOptions="Center">
                    <!-- Tasto per chiudere la modale -->
                    <Button Text="✕"
                            FontSize="18"
                            TextColor="#64748B"
                            BackgroundColor="#F1F5F9"
                            CornerRadius="18"
                            HorizontalOptions="End"
                            HeightRequest="36"
                            WidthRequest="36"
                            Padding="0"
                            Command="{Binding ChiudiSchermoGrandeCommand}" />

                    <!-- Immagine ingrandita -->
                    <Image Source="{Binding ActiveModalItem.Action.ImageUrl}"
                           WidthRequest="220"
                           HeightRequest="220"
                           Aspect="AspectFit"
                           HorizontalOptions="Center" />

                    <!-- Nome dell'azione in risalto -->
                    <Label Text="{Binding ActiveModalItem.Action.Name}"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="#0F2A4A"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Tasto di completamento azione -->
            <Button Grid.Row="1"
                    Text="✓ Fatto!"
                    FontSize="22"
                    FontAttributes="Bold"
                    BackgroundColor="#16A34A"
                    TextColor="#FFFFFF"
                    CornerRadius="18"
                    HeightRequest="60"
                    Margin="0,16,0,8"
                    Command="{Binding CompletaAzioneCorrenteCommand}">
                <Button.Shadow>
                    <Shadow Brush="#2516A34A"
                            Offset="0,4"
                            Radius="10"
                            Opacity="0.6" />
                </Button.Shadow>
            </Button>
        </Grid>

    </Grid>
</ContentPage>