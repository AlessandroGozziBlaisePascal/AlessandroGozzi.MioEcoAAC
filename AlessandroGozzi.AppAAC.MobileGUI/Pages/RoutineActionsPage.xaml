<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:AlessandroGozzi.AppAAC.MobileGUI.ViewModels"
             x:Class="AlessandroGozzi.AppAAC.MobileGUI.Pages.RoutineActionsPage"
             x:DataType="viewmodels:ActionsViewModel"
             Shell.BackButtonBehavior="{BackButtonBehavior IsVisible=False}"
             BackgroundColor="#F0F4F8">

    <!-- Barra superiore coordinata con freccia indietro e titolo -->
    <Shell.TitleView>
        <Grid ColumnDefinitions="Auto, *" VerticalOptions="Center" ColumnSpacing="12">
            <ImageButton Grid.Column="0"
                         Command="{Binding TornaIndietroCommand}"
                         BackgroundColor="Transparent"
                         HeightRequest="40"
                         WidthRequest="40"
                         Padding="6"
                         Aspect="AspectFit">
                <ImageButton.Source>
                    <FontImageSource Glyph="&#x2190;"
                                     FontFamily="OpenSansSemibold"
                                     Color="#0F2A4A"
                                     Size="26" />
                </ImageButton.Source>
            </ImageButton>

            <Label Grid.Column="1"
                   Text="Azioni da fare"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="#0F2A4A"
                   VerticalTextAlignment="Center" />
        </Grid>
    </Shell.TitleView>

    <Grid>
        <!-- 1. ELENCO DELLE AZIONI -->
        <CollectionView ItemsSource="{Binding ActionItems}"
                        Margin="16"
                        SelectionMode="None">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical"
                                 Span="2"
                                 HorizontalItemSpacing="14"
                                 VerticalItemSpacing="14" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:ActionStepItem">
                    <Border StrokeThickness="2"
                            StrokeShape="RoundRectangle 22"
                            Padding="14"
                            HeightRequest="190">

                        <Border.Shadow>
                            <Shadow Brush="#150284C7"
                                    Offset="0,4"
                                    Radius="10"
                                    Opacity="0.4" />
                        </Border.Shadow>

                        <!-- Stili condizionali: bloccato vs attivo vs completato -->
                        <Border.Style>
                            <Style TargetType="Border">
                                <!-- Stato base: bloccato / inattivo -->
                                <Setter Property="Stroke" Value="#E2E8F0" />
                                <Setter Property="BackgroundColor" Value="#E2E8F0" />
                                <Setter Property="Opacity" Value="0.45" />

                                <Style.Triggers>
                                    <!-- Quando l'azione è sbloccata / attiva: tema azzurro MioEco -->
                                    <DataTrigger TargetType="Border" Binding="{Binding IsUnlocked}" Value="True">
                                        <Setter Property="Stroke" Value="#0284C7" />
                                        <Setter Property="BackgroundColor" Value="#FFFFFF" />
                                        <Setter Property="Opacity" Value="1.0" />
                                    </DataTrigger>
                                    <!-- Quando l'azione è completata: verde rassicurante -->
                                    <DataTrigger TargetType="Border" Binding="{Binding IsCompleted}" Value="True">
                                        <Setter Property="Stroke" Value="#16A34A" />
                                        <Setter Property="BackgroundColor" Value="#F0FDF4" />
                                        <Setter Property="Opacity" Value="0.9" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ActionsViewModel}}, Path=ApriAzioneCommand}"
                                                  CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>

                        <VerticalStackLayout Spacing="10"
                                             HorizontalOptions="Center"
                                             VerticalOptions="Center">
                            <Grid HorizontalOptions="Center">
                                <Image Source="{Binding Action.ImageUrl}"
                                       WidthRequest="95"
                                       HeightRequest="95"
                                       Aspect="AspectFit" />

                                <!-- Badge spunta verde se completato -->
                                <Border BackgroundColor="#16A34A"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 14"
                                        WidthRequest="28"
                                        HeightRequest="28"
                                        HorizontalOptions="End"
                                        VerticalOptions="Start"
                                        Margin="0,-4,-4,0"
                                        IsVisible="{Binding IsCompleted}">
                                    <Label Text="✓"
                                           TextColor="White"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>
                            </Grid>

                            <Label Text="{Binding Action.Name}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#0F2A4A"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="2" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- 2. MODALE A TUTTO SCHERMO PER L'AZIONE SELEZIONATA -->
        <Grid BackgroundColor="#CC0F2A4A"
              IsVisible="{Binding IsModalOpen}"
              Padding="20"
              RowDefinitions="*, Auto">

            <!-- Card centrale ingrandita -->
            <Border Grid.Row="0"
                    Stroke="#38BDF8"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 28"
                    BackgroundColor="#FFFFFF"
                    Padding="24"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    MaximumWidthRequest="380">

                <Border.Shadow>
                    <Shadow Brush="#30000000"
                            Offset="0,8"
                            Radius="24"
                            Opacity="0.8" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="20" HorizontalOptions="Center">
                    <!-- Tasto per chiudere la modale -->
                    <Button Text="✕"
                            FontSize="18"
                            TextColor="#64748B"
                            BackgroundColor="#F1F5F9"
                            CornerRadius="18"
                            HorizontalOptions="End"
                            HeightRequest="36"
                            WidthRequest="36"
                            Padding="0"
                            Command="{Binding ChiudiSchermoGrandeCommand}" />

                    <!-- Immagine ingrandita -->
                    <Image Source="{Binding ActiveModalItem.Action.ImageUrl}"
                           WidthRequest="220"
                           HeightRequest="220"
                           Aspect="AspectFit"
                           HorizontalOptions="Center" />

                    <!-- Nome dell'azione in risalto -->
                    <Label Text="{Binding ActiveModalItem.Action.Name}"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="#0F2A4A"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Tasto di completamento azione -->
            <Button Grid.Row="1"
                    Text="✓ Fatto!"
                    FontSize="22"
                    FontAttributes="Bold"
                    BackgroundColor="#16A34A"
                    TextColor="#FFFFFF"
                    CornerRadius="18"
                    HeightRequest="60"
                    Margin="0,16,0,8"
                    Command="{Binding CompletaAzioneCorrenteCommand}">
                <Button.Shadow>
                    <Shadow Brush="#2516A34A"
                            Offset="0,4"
                            Radius="10"
                            Opacity="0.6" />
                </Button.Shadow>
            </Button>
        </Grid>
    </Grid>
</ContentPage>