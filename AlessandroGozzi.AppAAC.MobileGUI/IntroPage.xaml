<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AlessandroGozzi.AppAAC.MobileGUI.IntroPage"
             BackgroundColor="#F8FAFC"
             NavigationPage.HasNavigationBar="False">

    <Grid>
        <!-- Il contenitore con animazione -->
        <Border x:Name="LogoContainer"
            Stroke="#0F2A4A"
            StrokeThickness="2"
            Background="#FFFFFF"
            Padding="0"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            WidthRequest="220"
            HeightRequest="220"
            Opacity="0"
            Scale="0.8">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="32" />
            </Border.StrokeShape>

            <!-- L'immagine interna: NESSUN x:Name, solo Source -->
            <Image Source="app_logo.png"
               Aspect="AspectFit"
               WidthRequest="180"
               HeightRequest="180"
               HorizontalOptions="Center"
               VerticalOptions="Center" />
        </Border>
    </Grid>

</ContentPage>