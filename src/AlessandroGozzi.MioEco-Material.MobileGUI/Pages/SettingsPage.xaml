<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AlessandroGozzi.MioEco_Material.MobileGUI.ViewModels"
             xmlns:pages="clr-namespace:AlessandroGozzi.MioEco_Material.MobileGUI.Pages"
             x:Class="AlessandroGozzi.MioEco_Material.MobileGUI.Pages.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8FAFC">

    <Grid RowDefinitions="Auto, *">

        <!-- Header superiore con tasto indietro -->
        <Grid Grid.Row="0"
              Padding="16, 14"
              ColumnDefinitions="Auto, *"
              BackgroundColor="#FFFFFF">
            <Border Grid.Column="0"
                    StrokeShape="RoundRectangle 10"
                    Stroke="#E2E8F0"
                    StrokeThickness="1"
                    Background="#F8FAFC"
                    Padding="12, 6">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackClicked" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                    <Label Text="⬅" FontSize="16" TextColor="#0F2A4A" VerticalOptions="Center" />
                    <Label Text="Indietro" FontSize="14" FontAttributes="Bold" TextColor="#0F2A4A" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <Label Grid.Column="1"
                   Text="Impostazioni &amp; Info"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="#0F2A4A"
                   VerticalOptions="Center"
                   Margin="14, 0, 0, 0" />
        </Grid>

        <!-- Contenuto scrollabile -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="16" Padding="16">

                <!-- 1. Supporto e Feedback -->
                <Border StrokeShape="RoundRectangle 16"
                        Stroke="#E2E8F0"
                        StrokeThickness="1.5"
                        BackgroundColor="#FFFFFF"
                        Padding="16">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Assistenza e Feedback"
                               FontSize="17"
                               FontAttributes="Bold"
                               TextColor="#0F2A4A" />

                        <Label Text="Hai riscontrato un problema o vuoi suggerire nuove funzioni o pittogrammi? Invia una segnalazione diretta allo sviluppatore."
                               FontSize="13"
                               TextColor="#64748B" />

                        <Button Text="✉️ Invia segnalazione per email"
                                Command="{Binding InviaSegnalazioneCommand}"
                                BackgroundColor="#0284C7"
                                TextColor="#FFFFFF"
                                FontAttributes="Bold"
                                FontSize="14"
                                CornerRadius="12"
                                HeightRequest="44"
                                Margin="0, 4, 0, 0" />
                    </VerticalStackLayout>
                </Border>

                <!-- 2. Crediti ARASAAC -->
                <Border StrokeShape="RoundRectangle 16"
                        Stroke="#E2E8F0"
                        StrokeThickness="1.5"
                        BackgroundColor="#FFFFFF"
                        Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Simboli e Pittogrammi"
                               FontSize="17"
                               FontAttributes="Bold"
                               TextColor="#0F2A4A" />

                        <Label Text="I simboli pittografici utilizzati in questa applicazione appartengono al Governo di Aragona e sono stati creati da Sergio Palao per ARASAAC (http://www.arasaac.org), che li distribuisce sotto licenza Creative Commons BY-NC-SA."
                               FontSize="12"
                               TextColor="#475569"
                               LineHeight="1.25" />
                    </VerticalStackLayout>
                </Border>

                <!-- 3. Dettagli Applicazione -->
                <Border StrokeShape="RoundRectangle 16"
                        Stroke="#E2E8F0"
                        StrokeThickness="1.5"
                        BackgroundColor="#FFFFFF"
                        Padding="16">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Informazioni App"
                               FontSize="17"
                               FontAttributes="Bold"
                               TextColor="#0F2A4A" />

                        <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" RowSpacing="8">
                            <Label Grid.Row="0" Grid.Column="0" Text="Versione App" TextColor="#64748B" FontSize="13" />
                            <Label Grid.Row="0" Grid.Column="1" Text="1.0.0" TextColor="#0F2A4A" FontAttributes="Bold" FontSize="13" />

                            <Label Grid.Row="1" Grid.Column="0" Text="Sviluppatore" TextColor="#64748B" FontSize="13" />
                            <Label Grid.Row="1" Grid.Column="1" Text="Alessandro Gozzi" TextColor="#0F2A4A" FontAttributes="Bold" FontSize="13" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>